PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000

# Clave publica de Stripe para el frontend.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Clave secreta de Stripe para crear sesiones de Checkout en el servidor.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Secreto del webhook. Debe empezar por "whsec_".
# Si pruebas en local con Stripe CLI:
# stripe listen --forward-to localhost:3000/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# EmailJS para enviar confirmaciones cuando un usuario reserva una clase.
EMAILJS_SERVICE_ID=service_xxxxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxxxx
EMAILJS_CANCEL_TEMPLATE_ID=template_cancel_xxxxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx

# Opcional: private key de EmailJS si la tienes activada para llamadas REST.
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxx
